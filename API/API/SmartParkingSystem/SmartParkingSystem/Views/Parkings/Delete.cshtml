@model SmartParkingSystem.Models.Parking

@{
    ViewData["Title"] = "Delete Parking";
}

<!-- Custom CSS Styling -->
<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .delete-container {
        background-color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-top: 50px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    h2, h4 {
        color: #dc3545;
        font-weight: bold;
    }

    dt {
        font-weight: 600;
    }

    .btn-delete {
        background-color: #dc3545;
        border: none;
        padding: 10px 25px;
        font-weight: 500;
        border-radius: 8px;
        color: white;
        transition: 0.3s ease-in-out;
    }

        .btn-delete:hover {
            background-color: #bb2d3b;
        }

    .btn-cancel {
        background-color: #0d6efd;
        border: none;
        padding: 10px 25px;
        font-weight: 500;
        border-radius: 8px;
        color: white;
        margin-left: 10px;
        transition: 0.3s ease-in-out;
    }

        .btn-cancel:hover {
            background-color: #0b5ed7;
        }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="delete-container">
                <h2><i class="bi bi-trash3-fill"></i> Delete Parking Spot</h2>
                <hr />
                <h4 class="mb-4 text-danger">Are you sure you want to delete this?</h4>

                <dl class="row">
                    <dt class="col-sm-4">
                        <i class="bi bi-car-front-fill text-primary"></i> @Html.DisplayNameFor(model => model.name)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.name)
                    </dd>

                    <dt class="col-sm-4">
                        <i class="bi bi-diagram-3-fill text-primary"></i> @Html.DisplayNameFor(model => model.Parkingtype)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Parkingtype)
                    </dd>

                    <dt class="col-sm-4">
                        <i class="bi bi-currency-dollar text-primary"></i> @Html.DisplayNameFor(model => model.priceperhour)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.priceperhour)
                    </dd>

                    <dt class="col-sm-4">
                        <i class="bi bi-check-circle-fill text-primary"></i> @Html.DisplayNameFor(model => model.isOccupied)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.isOccupied)
                    </dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="id" />
                    <button type="submit" class="btn btn-delete"><i class="bi bi-trash-fill"></i> Confirm Delete</button>
                    <a asp-action="Index" class="btn btn-cancel"><i class="bi bi-arrow-left"></i> Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
