@model CarParking

@{
    ViewData["Title"] = "Edit";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .edit-container {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 30px 35px;
        margin: 40px auto;
    }

    .edit-header {
        font-size: 2rem;
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

        .edit-header i {
            font-size: 2.2rem;
        }

    .form-group label {
        font-weight: 600;
        color: #0d6efd;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-control {
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 1rem;
        border: 1.5px solid #ced4da;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.4);
            outline: none;
        }

    .text-danger {
        margin-top: 3px;
        font-size: 0.875rem;
    }

    .btn-primary-custom {
        background-color: #0d6efd;
        color: white;
        font-weight: 600;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: background-color 0.3s ease;
        font-size: 1rem;
        width: 100%;
        justify-content: center;
    }

        .btn-primary-custom:hover {
            background-color: #084298;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        margin-top: 20px;
        color: #6c757d;
        text-decoration: none;
        font-size: 1rem;
    }

        .back-link:hover {
            text-decoration: underline;
            color: #0d6efd;
        }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="edit-container">
                <div class="edit-header">
                    <i class="bi bi-pencil-square"></i>
                    Edit Car Parking
                </div>

                <form asp-action="Edit" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="id" />

                    <div class="form-group mb-3">
                        <label asp-for="parkingID">
                            <i class="bi bi-building"></i> Parking Location
                        </label>
                        <select asp-for="parkingID" class="form-control" asp-items="ViewBag.parkingID"></select>
                        <span asp-validation-for="parkingID" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="carNumber">
                            <i class="bi bi-car-front-fill"></i> Car Number
                        </label>
                        <input asp-for="carNumber" class="form-control" />
                        <span asp-validation-for="carNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4">
                        <label asp-for="EasyPaisaPhoneNumber">
                            <i class="bi bi-phone-vibrate"></i> EasyPaisa Phone Number
                        </label>
                        <input asp-for="EasyPaisaPhoneNumber" class="form-control" maxlength="15" />
                        <span asp-validation-for="EasyPaisaPhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Email">
                            <i class="bi bi-envelope-fill"></i> Email
                        </label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="parkingStartTime">
                            <i class="bi bi-clock-history"></i> Parking Start Time
                        </label>
                        <input asp-for="parkingStartTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="parkingStartTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="parkingEndTime">
                            <i class="bi bi-clock"></i> Parking End Time
                        </label>
                        <input asp-for="parkingEndTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="parkingEndTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="totalAmount">
                            <i class="bi bi-currency-dollar"></i> Total Amount
                        </label>
                        <input asp-for="totalAmount" class="form-control" />
                        <span asp-validation-for="totalAmount" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-primary-custom">
                        <i class="bi bi-check-circle-fill"></i> Save Changes
                    </button>
                </form>

                <a asp-action="Index" class="back-link mt-4">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
