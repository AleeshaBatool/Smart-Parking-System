@model IEnumerable<CarParking>

@{
    ViewData["Title"] = "Car Parking Records";
}

<!-- Custom Styling -->
<style>
    body {
        background-color: #f4f6f9;
        font-family: 'Segoe UI', sans-serif;
    }

    .container-custom {
        background-color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-top: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    h2 {
        color: #0d6efd;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .btn-create {
        background-color: #198754;
        color: #fff;
        font-weight: 500;
        border-radius: 8px;
        transition: 0.3s;
    }

        .btn-create:hover {
            background-color: #157347;
        }

    .action-links a {
        margin-right: 10px;
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .badge-id {
        background-color: #6c757d;
        color: white;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 0.9rem;
    }
</style>

<div class="container container-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Car Parking Records</h2>
        <a asp-action="Create" class="btn btn-create">+ Create New</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().carNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.First().parkingStartTime)</th>
                    <th>@Html.DisplayNameFor(model => model.First().parkingEndTime)</th>
                    <th>@Html.DisplayNameFor(model => model.First().totalAmount)</th>
                    <th>Parking Spot ID</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.carNumber</td>
                        <td>@(item.parkingStartTime.HasValue ? item.parkingStartTime.Value.ToString("g") : "N/A")</td>

                        <td>@item.parkingEndTime?.ToString("g")</td>
                        <td>@item.totalAmount.ToString("C")</td>
                        <td><span class="badge-id">@item.Parking?.id</span></td>
                        <td class="action-links">
                            <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
