@model SmartParkingSystem.Models.Parking

@{
    ViewData["Title"] = "Parking Details";
}

<style>
    .details-container {
        background-color: #ffffff;
        border-radius: 12px;
        padding: 30px;
        margin-top: 40px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
        color: #198754; /* Bootstrap success green */
        font-weight: 700;
    }

    dt {
        font-weight: 600;
        color: #0d6efd; /* Bootstrap primary blue */
    }

    dd {
        font-size: 1.1rem;
        margin-bottom: 15px;
    }

    .btn-details {
        margin-top: 20px;
    }

    .btn-edit {
        background-color: #0d6efd;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        transition: background-color 0.3s ease-in-out;
        text-decoration: none;
    }

        .btn-edit:hover {
            background-color: #0b5ed7;
            color: white;
            text-decoration: none;
        }

    .btn-back {
        margin-left: 15px;
        color: #6c757d;
        font-weight: 600;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #6c757d;
        transition: background-color 0.3s ease-in-out;
    }

        .btn-back:hover {
            background-color: #6c757d;
            color: white;
            text-decoration: none;
        }
</style>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 details-container">
            <h1><i class="bi bi-info-circle-fill"></i> Parking Details</h1>
            <hr />
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.name)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.name)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Parkingtype)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Parkingtype)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.priceperhour)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.priceperhour)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.isOccupied)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.isOccupied)</dd>
            </dl>

            <div class="btn-details">
                <a asp-action="Edit" asp-route-id="@Model?.id" class="btn-edit">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
}
